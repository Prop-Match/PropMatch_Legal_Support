# Application
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# NestJS authenticates users and calls this service with an internal key. Use
# the same long random value as LEGAL_SUPPORT_INTERNAL_API_KEY in NestJS.
AUTH_REQUIRED=true
INTERNAL_SERVICE_API_KEY=replace-with-a-long-random-internal-service-key
# Optional legacy/direct JWT fallback, used only when INTERNAL_SERVICE_API_KEY
# is empty. Leave unset for the intended NestJS gateway architecture.
JWT_SECRET=
JWT_ALGORITHM=HS256

# ITI LLM API (same provider contract used by FormOptimizerService)
SBG_API_KEY=replace-with-your-iti-api-key
LLM_API_URL=http://apiaccess.iti.net.eg/api/v1/student/chat
LLM_MODEL_ID=openai.gpt-oss-120b-1:0
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SECONDS=90

# ChromaDB. `localhost` is correct when Python runs on your host. The Compose
# `api` service overrides this to the internal service name `chroma`.
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_COLLECTION=egypt_real_estate_laws

# ITI embedding API. EMBEDDING_API_KEY is optional; if blank, SBG_API_KEY is
# reused. Change EMBEDDING_MODEL_ID later without changing application code.
EMBEDDING_API_URL=http://apiaccess.iti.net.eg/api/v1/student/embed
EMBEDDING_API_KEY=
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0:8k
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60

# RAG corpus/retrieval
LAWS_DIR=laws/egypt_real_estate_laws_txt_for_rag
CHUNK_SIZE=1400
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
RELEVANCE_MAX_DISTANCE=0.72
